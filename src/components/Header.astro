---
import { GITHUB_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="glass-card" data-glass-floating aria-label="主导航">
		<span class="nav-glass-background" aria-hidden="true"></span>
		<div class="site-brand">
			<a href="/" class="logo-link" aria-label="返回首页">
				<img class="logo-badge" src="/favicon.png?v=3" alt="" width="36" height="36" />
				<span class="logo-text">Skittles's <span>Blog</span></span>
			</a>
		</div>

		<div class="internal-links" id="primary-navigation" data-glass-floating>
			<span class="menu-glass-background" aria-hidden="true"></span>
			<span class="nav-lens" aria-hidden="true" data-glass-floating></span>
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<HeaderLink href="/links">友链</HeaderLink>
		</div>

		<div class="nav-actions">
			<a class="github-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="访问 Skittles 的 GitHub 主页">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.96 10.96 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.18c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" />
				</svg>
			</a>
			<button id="theme-toggle" class="icon-button" type="button" aria-label="切换明暗主题">
				<svg class="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
				</svg>
			</button>
			<button id="menu-toggle" class="icon-button menu-toggle" type="button" aria-label="打开导航菜单" aria-controls="primary-navigation" aria-expanded="false">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		padding: 0.95rem 0 0.45rem;
	}
	nav.glass-card {
		--navigation-radius: 26px;
		--navigation-control-radius: calc(var(--navigation-radius) - 10px);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		justify-content: space-between;
		width: min(var(--content-width), 100% - 2 * var(--site-gutter));
		margin: 0 auto;
		padding: 0.45rem 1.25rem;
		border-radius: var(--navigation-radius);
		corner-shape: superellipse(var(--liquid-glass-corner));
		background: transparent !important;
		border: none !important;
		-webkit-backdrop-filter: none !important;
		backdrop-filter: none !important;
		transition: none;
		box-shadow: var(--liquid-glass-edge), var(--glass-shadow);
	}
	nav.glass-card::before { display: none; }
	.nav-glass-background,
	.menu-glass-background {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		corner-shape: inherit;
		pointer-events: none;
		background: var(--liquid-glass-tint);
		-webkit-backdrop-filter: blur(var(--navigation-glass-blur)) saturate(var(--liquid-glass-saturation));
		backdrop-filter: blur(var(--navigation-glass-blur)) saturate(var(--liquid-glass-saturation));
		transition: --navigation-glass-blur 100ms ease, background-color 100ms ease;
	}
	.menu-glass-background { display: none; }
	nav[data-nav-scrolled] .nav-glass-background {
		--navigation-glass-blur: 5px;
		background: var(--liquid-glass-reading-tint);
		/* Keep the sticky bar on the browser's native blur path over moving content. */
		-webkit-backdrop-filter: blur(var(--navigation-glass-blur)) saturate(var(--liquid-glass-saturation)) !important;
		backdrop-filter: blur(var(--navigation-glass-blur)) saturate(var(--liquid-glass-saturation)) !important;
	}
	.site-brand { font-size: 1.15rem; }
	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0;
		text-decoration: none;
	}
	.logo-badge {
		display: block;
		flex: none;
		width: 36px;
		height: 36px;
		border-radius: 11px;
		box-shadow: 0 3px 9px rgb(39 13 35 / 0.28);
	}
	.logo-text {
		color: var(--text-color);
		font-family: var(--font-display);
		font-size: 1.08em;
		font-weight: 600;
		letter-spacing: -0.025em;
		white-space: nowrap;
		text-shadow: var(--surface-text-shadow);
	}
	.logo-text span { color: var(--accent); font-weight: 800; }
	.internal-links {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.25rem;
		position: relative;
	}
	.internal-links :global(a) {
		grid-row: 1;
		position: relative;
		padding: 0.52rem 0.9rem;
		border-radius: var(--navigation-control-radius);
		corner-shape: superellipse(var(--liquid-glass-corner));
		color: var(--text-muted) !important;
		font-size: 0.95rem;
		font-weight: 600;
		text-align: center;
		white-space: nowrap;
		text-decoration: none;
	}
	.internal-links :global(a:nth-of-type(1)) { grid-column: 1; }
	.internal-links :global(a:nth-of-type(2)) { grid-column: 2; }
	.internal-links :global(a:nth-of-type(3)) { grid-column: 3; }
	.internal-links :global(a:nth-of-type(4)) { grid-column: 4; }
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--text-color) !important;
	}
	.internal-links :global(a.active) { background: rgba(255, 228, 241, 0.16); }
	.internal-links :global(a:focus-visible) {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}
	.nav-lens { display: none; }
	@supports selector(:has(a.active)) {
		.internal-links :global(a.active) { background: transparent; }
	}
	.nav-lens {
		--navigation-glass-blur: 3px;
		grid-row: 1;
		grid-column: var(--active-slot);
		align-self: stretch;
		position: relative;
		border-radius: var(--navigation-control-radius);
		corner-shape: superellipse(var(--liquid-glass-corner));
		isolation: isolate;
		pointer-events: none;
		background: rgb(255 255 255 / 0.10);
		-webkit-backdrop-filter: blur(var(--navigation-glass-blur)) saturate(var(--liquid-glass-saturation));
		backdrop-filter: blur(var(--navigation-glass-blur)) saturate(var(--liquid-glass-saturation));
		box-shadow: var(--liquid-glass-edge), 0 3px 10px rgb(24 15 33 / 0.20);
		transition: --navigation-glass-blur 100ms ease, background-color 100ms ease;
	}
	nav[data-lens-moving] .nav-lens {
		--navigation-glass-blur: 0.25px;
		background-color: rgb(255 255 255 / 0.025);
	}
	@media (min-width: 721px) {
		#primary-navigation {
			background: transparent;
			border: 0;
			box-shadow: none;
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
		#primary-navigation::before { display: none; }
	}
	.nav-actions { display: flex; justify-self: end; align-items: center; gap: 0.35rem; }
	.github-link,
	.icon-button {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		box-sizing: border-box;
		padding: 0;
		border: 0;
		border-radius: var(--navigation-control-radius);
		corner-shape: superellipse(var(--liquid-glass-corner));
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
	}
	.github-link:hover,
	.icon-button:hover,
	.icon-button[aria-expanded="true"] {
		color: var(--text-color);
		background: rgba(255, 255, 255, 0.14);
	}
	#theme-toggle {
		--liquid-glass-blur: 3px;
		border-radius: 50%;
		corner-shape: round;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.34);
		border-top-color: rgba(255, 255, 255, 0.72);
		-webkit-backdrop-filter: blur(var(--liquid-glass-blur)) saturate(var(--liquid-glass-saturation));
		backdrop-filter: blur(var(--liquid-glass-blur)) saturate(var(--liquid-glass-saturation));
		box-shadow:
			inset 1.5px 1.5px 1px rgba(255, 255, 255, 0.45),
			inset -1px -1px 1px rgba(255, 255, 255, 0.22),
			0 2px 8px rgba(14, 8, 26, 0.18);
		color: var(--text-color);
	}
	#theme-toggle:hover {
		background: rgba(255, 255, 255, 0.20);
		border-color: rgba(255, 255, 255, 0.52);
		border-top-color: rgba(255, 255, 255, 0.88);
		box-shadow:
			inset 2px 2px 1.5px rgba(255, 255, 255, 0.62),
			inset -1px -1px 1.5px rgba(255, 255, 255, 0.34),
			0 4px 12px rgba(14, 8, 26, 0.24);
		transform: scale(1.06);
	}
	#theme-toggle:active {
		transform: scale(0.94);
	}
	:root[data-theme="dark"] #theme-toggle {
		background: rgba(255, 255, 255, 0.09);
		border-color: rgba(255, 255, 255, 0.26);
		border-top-color: rgba(255, 255, 255, 0.56);
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) #theme-toggle {
			background: rgba(255, 255, 255, 0.09);
			border-color: rgba(255, 255, 255, 0.26);
			border-top-color: rgba(255, 255, 255, 0.56);
		}
	}
	.github-link,
	.icon-button { transition: color 150ms ease, background-color 150ms ease, transform 120ms var(--ease-out); }
	.github-link:active,
	.icon-button:active { transform: scale(0.96); }
	.moon,
	:root[data-theme="dark"] .sun { display: none; }
	:root[data-theme="dark"] .moon { display: block; }
	.menu-toggle { display: none; }

	@media (max-width: 720px) {
		header { padding: 0.4rem 0; }
		nav.glass-card {
			--navigation-radius: 22px;
			display: flex;
			padding: 0.5rem 0.65rem;
		}
		.menu-glass-background {
			display: block;
			background: var(--liquid-glass-floating-tint);
		}
		.github-link { display: none; }
		.menu-toggle { display: grid; }
		.internal-links {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: repeat(4, auto);
			position: absolute;
			top: calc(100% + 0.6rem);
			left: 0;
			right: 0;
			gap: 0.2rem;
			padding: 0.65rem;
			border-radius: var(--liquid-glass-panel-radius);
			corner-shape: superellipse(var(--liquid-glass-corner));
			isolation: isolate;
			box-shadow: var(--liquid-glass-edge), var(--glass-shadow);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transform: translateY(-6px) scale(0.98);
			transform-origin: top right;
			transition: opacity 160ms var(--ease-out), transform 180ms var(--ease-out), visibility 180ms;
		}
		nav.menu-open .internal-links {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: translateY(0) scale(1);
		}
		.internal-links :global(a) { padding: 0.7rem; text-align: center; }
		.internal-links :global(a:nth-of-type(1)) { grid-area: 1 / 1; }
		.internal-links :global(a:nth-of-type(2)) { grid-area: 2 / 1; }
		.internal-links :global(a:nth-of-type(3)) { grid-area: 3 / 1; }
		.internal-links :global(a:nth-of-type(4)) { grid-area: 4 / 1; }
		.nav-lens { grid-area: var(--active-slot) / 1; }
	}
	@media (prefers-reduced-motion: reduce) {
		.internal-links { transition: opacity 120ms ease; transform: none; }
	}
	@media (prefers-reduced-transparency: reduce) {
		nav[data-nav-scrolled] .nav-glass-background,
		.nav-glass-background,
		.menu-glass-background {
			background: #232030 !important;
			color: #f7f7fa !important;
			-webkit-backdrop-filter: none !important;
			backdrop-filter: none !important;
		}
		.nav-lens,
		#theme-toggle {
			background: #554957 !important;
			-webkit-backdrop-filter: none !important;
			backdrop-filter: none !important;
		}
	}
	@media (prefers-contrast: more) {
		.internal-links {
			border-color: rgba(255, 255, 255, 0.58);
		}
		.nav-lens { outline: 1px solid rgba(255, 246, 252, 0.8); }
	}
	@media (max-width: 380px) {
		.logo-text { font-size: 0.9rem; }
	}
</style>

<style is:global>
	@property --navigation-glass-blur {
		syntax: '<length>';
		inherits: false;
		initial-value: 3.75px;
	}

	#primary-navigation:has(> a:nth-of-type(1).active) { --active-slot: 1; }
	#primary-navigation:has(> a:nth-of-type(2).active) { --active-slot: 2; }
	#primary-navigation:has(> a:nth-of-type(3).active) { --active-slot: 3; }
	#primary-navigation:has(> a:nth-of-type(4).active) { --active-slot: 4; }
	#primary-navigation:has(> a.active) > .nav-lens { display: block; }
</style>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	const menuToggle = document.getElementById('menu-toggle');
	const nav = menuToggle?.closest('nav');
	const updateScrollMaterial = () => nav?.toggleAttribute('data-nav-scrolled', window.scrollY > 24);
	window.addEventListener('scroll', updateScrollMaterial, { passive: true });
	updateScrollMaterial();

	const closeMenu = () => {
		nav?.classList.remove('menu-open');
		menuToggle?.setAttribute('aria-expanded', 'false');
		menuToggle?.setAttribute('aria-label', '打开导航菜单');
	};

	menuToggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('menu-open') ?? false;
		menuToggle.setAttribute('aria-expanded', String(isOpen));
		menuToggle.setAttribute('aria-label', isOpen ? '关闭导航菜单' : '打开导航菜单');
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || !nav?.classList.contains('menu-open')) return;
		closeMenu();
		menuToggle?.focus();
	});
	document.addEventListener('pointerdown', (event) => {
		if (event.target instanceof Node && !nav?.contains(event.target)) closeMenu();
	});

	const getTheme = () => localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
	themeToggle?.addEventListener('click', () => {
		const theme = getTheme() === 'dark' ? 'light' : 'dark';
		document.documentElement.classList.add('theme-switching');
		document.documentElement.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
		window.setTimeout(() => document.documentElement.classList.remove('theme-switching'), 260);
	});

	// Animate the live backdrop so it keeps sampling the page as the lens moves.
	const primaryNav = document.getElementById('primary-navigation');
	const navLens = primaryNav?.querySelector<HTMLElement>('.nav-lens');
	const navLinks = Array.from(primaryNav?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
	const desktopQuery = window.matchMedia('(min-width: 721px)');
	const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (primaryNav && navLens && navLinks.length) {
		const activeLink = navLinks.find((link) => link.classList.contains('active'));
		const storageKey = 'blog-navigation-lens';
		const pathKey = (address: URL) => address.pathname.replace(/\/$/, '') || '/';
		let lensAnimation: Animation | undefined;
		let targetLink = activeLink;
		let navigatingFromMenu = false;

		const moveLensTo = (destination = activeLink, startLeft?: number) => {
			if (!activeLink || !destination || motionQuery.matches) return;
			if (destination === targetLink && startLeft === undefined) return;
			const start = getComputedStyle(navLens).transform;
			const x = destination.offsetLeft - activeLink.offsetLeft;
			const y = destination.offsetTop - activeLink.offsetTop;
			const from = startLeft === undefined ? start : `translateX(${startLeft - activeLink.offsetLeft}px)`;
			const to = `translate(${x}px, ${y}px)`;
			targetLink = destination;
			lensAnimation?.cancel();
			navLens.style.transform = to;
			nav?.setAttribute('data-lens-moving', '');
			const animation = navLens.animate([
				{ transform: from },
				{ transform: `${to} scale(1.06, 0.96)`, offset: 0.74 },
				{ transform: to },
			], { duration: 290, easing: 'cubic-bezier(0.24, 0.78, 0.34, 1)' });
			lensAnimation = animation;
			const settle = () => {
				if (lensAnimation !== animation) return;
				lensAnimation = undefined;
				nav?.removeAttribute('data-lens-moving');
			};
			void animation.finished.then(settle, settle);
			return animation;
		};

		navLinks.forEach((link) => {
			link.addEventListener('pointerenter', (event) => {
				if (desktopQuery.matches && event.pointerType !== 'touch') moveLensTo(link);
			});
			link.addEventListener('focus', () => {
				if (desktopQuery.matches) moveLensTo(link);
			});
			link.addEventListener('click', (event) => {
				if (event.defaultPrevented || event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				if (navigatingFromMenu) {
					event.preventDefault();
					return;
				}
				const url = new URL(link.href);
				const targetPath = pathKey(url);
				if (targetPath === pathKey(new URL(location.href)) || motionQuery.matches) {
					closeMenu();
					return;
				}
				if (desktopQuery.matches) {
					try {
						const left = navLens.getBoundingClientRect().left - primaryNav.getBoundingClientRect().left;
						sessionStorage.setItem(storageKey, JSON.stringify({ targetPath, left, time: Date.now() }));
					} catch { /* Storage can be disabled independently of navigation. */ }
					return;
				}
				const animation = moveLensTo(link);
				if (!animation) return;
				event.preventDefault();
				navigatingFromMenu = true;
				const followLink = () => location.assign(url.href);
				void animation.finished.then(followLink, followLink);
			});
		});
		primaryNav.addEventListener('pointerleave', () => {
			if (desktopQuery.matches) moveLensTo();
		});
		primaryNav.addEventListener('focusout', (event) => {
			if (desktopQuery.matches && !primaryNav.contains(event.relatedTarget as Node | null)) {
				moveLensTo();
			}
		});
		const resetLens = () => {
			lensAnimation?.cancel();
			targetLink = activeLink;
			navLens.style.transform = '';
		};
		desktopQuery.addEventListener('change', resetLens);
		motionQuery.addEventListener('change', resetLens);
		window.addEventListener('pageshow', (event) => {
			if (event.persisted) {
				resetLens();
				navigatingFromMenu = false;
				closeMenu();
			}
		});
		try {
			const pending = sessionStorage.getItem(storageKey);
			if (pending) {
				sessionStorage.removeItem(storageKey);
				const { targetPath, left, time } = JSON.parse(pending);
				if (desktopQuery.matches && activeLink && targetPath === pathKey(new URL(location.href))
					&& Date.now() - time < 5000 && Number.isFinite(left) && Math.abs(left - activeLink.offsetLeft) > 2) {
					moveLensTo(activeLink, left);
				}
			}
		} catch { /* An unavailable or invalid saved position is optional. */ }
	}
</script>
