---
import { GITHUB_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="glass-card" aria-label="主导航">
		<h2>
			<a href="/" class="logo-link" aria-label="返回首页">
				<span class="logo-badge">S</span>
				<span class="logo-text">Skittles's <span>Blog</span></span>
			</a>
		</h2>

		<div class="internal-links" id="primary-navigation">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<HeaderLink href="/links">友链</HeaderLink>
		</div>

		<div class="nav-actions">
			<a class="github-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="访问 Skittles 的 GitHub 主页">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.96 10.96 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.18c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" />
				</svg>
			</a>
			<button id="theme-toggle" class="icon-button" type="button" aria-label="切换明暗主题">
				<svg class="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
				</svg>
			</button>
			<button id="menu-toggle" class="icon-button menu-toggle" type="button" aria-label="打开导航菜单" aria-controls="primary-navigation" aria-expanded="false">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		padding: 0.8rem 0;
	}
	nav.glass-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 900px;
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: 0.5rem 1.35rem;
		border-radius: 20px;
		background: var(--material-thick) !important;
		border-color: var(--material-border) !important;
		-webkit-backdrop-filter: blur(12px) saturate(140%);
		backdrop-filter: blur(12px) saturate(140%);
		transition: none;
	}
	h2 { margin: 0; font-size: 1.15rem; }
	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0;
		text-decoration: none;
	}
	.logo-badge {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		color: white;
		font-weight: 800;
		box-shadow: 0 4px 12px rgba(var(--accent-color), 0.35);
	}
	.logo-text { color: white; font-weight: 700; white-space: nowrap; }
	.logo-text span { color: var(--accent); font-weight: 800; }
	.internal-links { display: flex; align-items: center; gap: 0.35rem; }
	.internal-links :global(a) {
		padding: 0.7rem 0.85rem;
		border-radius: 10px;
		color: rgba(255, 255, 255, 0.78) !important;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: white !important;
		background: rgba(var(--accent-color), 0.16) !important;
	}
	.internal-links :global(a.active) { color: var(--accent) !important; }
	.nav-actions { display: flex; align-items: center; gap: 0.25rem; }
	.github-link,
	.icon-button {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		box-sizing: border-box;
		padding: 0;
		border: 0;
		border-radius: 10px;
		background: transparent;
		color: rgba(255, 255, 255, 0.75);
		cursor: pointer;
	}
	.github-link:hover,
	.icon-button:hover,
	.icon-button[aria-expanded="true"] {
		color: white;
		background: rgba(var(--accent-color), 0.16);
	}
	.github-link,
	.icon-button { transition: color 150ms ease, background-color 150ms ease, transform 120ms var(--ease-out); }
	.github-link:active,
	.icon-button:active { transform: scale(0.96); }
	.moon,
	:root[data-theme="dark"] .sun { display: none; }
	:root[data-theme="dark"] .moon { display: block; }
	.menu-toggle { display: none; }

	@media (max-width: 720px) {
		header { padding: 0.4rem 0; }
		nav.glass-card {
			max-width: calc(100% - 1.25rem);
			padding: 0.5rem 0.65rem;
			border-radius: 15px;
		}
		.github-link { display: none; }
		.menu-toggle { display: grid; }
		.internal-links {
			display: flex;
			position: absolute;
			top: calc(100% + 0.6rem);
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0.2rem;
			padding: 0.65rem;
			border: 1px solid rgba(255, 255, 255, 0.16);
			border-radius: 16px;
			background: var(--material-thick);
			box-shadow: 0 18px 45px rgba(0, 0, 0, 0.3);
			-webkit-backdrop-filter: blur(12px) saturate(140%);
			backdrop-filter: blur(12px) saturate(140%);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transform: translateY(-6px) scale(0.98);
			transform-origin: top right;
			transition: opacity 160ms var(--ease-out), transform 180ms var(--ease-out), visibility 180ms;
		}
		nav.menu-open .internal-links {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: translateY(0) scale(1);
		}
		.internal-links :global(a) { padding: 0.7rem; text-align: center; }
	}
	@media (prefers-reduced-motion: reduce) {
		.internal-links { transition: opacity 120ms ease; transform: none; }
	}
	@media (prefers-reduced-transparency: reduce) {
		nav.glass-card,
		.internal-links {
			background: #252838 !important;
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}
	@media (max-width: 380px) {
		.logo-text { font-size: 0.9rem; }
		.logo-text span { display: none; }
	}
</style>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	const menuToggle = document.getElementById('menu-toggle');
	const nav = menuToggle?.closest('nav');

	const closeMenu = () => {
		nav?.classList.remove('menu-open');
		menuToggle?.setAttribute('aria-expanded', 'false');
	};

	menuToggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('menu-open') ?? false;
		menuToggle.setAttribute('aria-expanded', String(isOpen));
	});
	document.querySelectorAll('#primary-navigation a').forEach((link) => link.addEventListener('click', closeMenu));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});

	const getTheme = () => localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
	themeToggle?.addEventListener('click', () => {
		const theme = getTheme() === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
	});
</script>
