---
import { CONTACT_EMAIL, GITHUB_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<p>&copy; {year} Skittles’s Blog</p>
	<nav aria-label="页脚链接">
		<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
		<a href={`mailto:${CONTACT_EMAIL}`}>邮件</a>
		<a href="/rss.xml">RSS</a>
	</nav>
</footer>

<style>
	footer {
		padding: 2.5rem 1rem 3rem;
		color: rgba(255, 255, 255, 0.72);
		text-align: center;
		font-size: 0.9rem;
	}
	footer p { margin: 0 0 0.75rem; }
	nav { display: flex; justify-content: center; gap: 1rem; }
	a { color: inherit; text-decoration: none; font-weight: 600; }
	a:hover { color: var(--accent); }
</style>
