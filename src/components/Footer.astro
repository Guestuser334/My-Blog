---
import { CONTACT_EMAIL, GITHUB_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<p>&copy; {year} Skittles’s Blog</p>
	<nav aria-label="页脚链接">
		<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
		<a href={`mailto:${CONTACT_EMAIL}`}>邮件</a>
		<a href="/rss.xml">RSS</a>
	</nav>
</footer>

<style>
	footer {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.6rem 1rem;
		width: min(var(--content-width), 100% - 2 * var(--site-gutter));
		margin: 0 auto;
		padding: 1rem 0 2rem;
		border-top: 1px solid var(--panel-line);
		color: var(--text-muted);
		font-size: 0.86rem;
		text-shadow: var(--surface-text-shadow);
	}
	footer p { margin: 0; }
	nav { display: flex; gap: 1rem; }
	a { color: inherit; text-decoration: none; font-weight: 600; }
	a:hover { color: var(--rose-ink); }
</style>
