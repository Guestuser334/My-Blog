---
import Layout from '../layouts/PageLayout.astro';
import { REPOSITORY_URL } from '../consts';

const links = [
	{
		name: "tukwhy",
		url: "https://tukwhy.top",
		avatar: "https://tukwhy.top/medias/avatar.jpg",
		description: "西郊有密林，助君出重围"
	}
];
---

<Layout
	title="友情链接"
	description="一些值得常去看看的朋友与站点。"
>
	<p class="links-intro">
		欢迎交换友链！你可以在“关于”页面找到我的联系方式，或者在 <a href={REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub 仓库</a>提交 PR。
	</p>
	
	<div class="links-grid">
		{links.map(link => (
			<a href={link.url} target="_blank" rel="noopener noreferrer" class="link-card-wrapper">
				<div class="link-card" data-glass>
					<div class="avatar-container">
						<span class="avatar-fallback" aria-hidden="true">{link.name.slice(0, 1).toUpperCase()}</span>
						<img src={link.avatar} alt="" class="link-avatar" loading="lazy" />
						<div class="avatar-glow"></div>
					</div>
					<div class="link-info">
						<h3 class="link-name">{link.name}</h3>
						<p class="link-description">{link.description}</p>
					</div>
					<span class="visit-icon" aria-hidden="true">↗</span>
				</div>
			</a>
		))}
	</div>
</Layout>

<script>
	for (const avatar of document.querySelectorAll<HTMLImageElement>('.link-avatar')) {
		const hideBrokenAvatar = () => { avatar.hidden = true; };
		avatar.addEventListener('error', hideBrokenAvatar, { once: true });
		if (avatar.complete && !avatar.naturalWidth) hideBrokenAvatar();
	}
</script>

<style>
	.links-intro {
		color: var(--text-muted);
		margin-bottom: 1.35rem;
		font-size: 0.98rem;
	}
	
	.links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: var(--layout-gap);
		margin: 0;
	}
	
	.link-card-wrapper {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	
	.link-card {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.3rem 1.4rem;
		min-height: 112px;
		box-sizing: border-box;
		border-radius: 22px;
		background: var(--journal-glass);
		border: 1px solid var(--panel-line);
		-webkit-backdrop-filter: blur(1px) saturate(120%) brightness(1.03);
		backdrop-filter: blur(1px) saturate(120%) brightness(1.03);
		box-shadow: var(--glass-inner-bevel), var(--glass-shadow);
		transition: transform 220ms var(--ease-spring), background-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
		position: relative;
		isolation: isolate;
		overflow: hidden;
	}

	:root[data-theme="dark"] .link-card {
		-webkit-backdrop-filter: blur(1.2px) saturate(120%) brightness(1.02);
		backdrop-filter: blur(1.2px) saturate(120%) brightness(1.02);
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) .link-card {
			-webkit-backdrop-filter: blur(1.2px) saturate(120%) brightness(1.02);
			backdrop-filter: blur(1.2px) saturate(120%) brightness(1.02);
		}
	}

	.link-card-wrapper:hover .link-card {
		transform: translateY(-3px);
		background: var(--card-hover-bg);
		box-shadow: var(--glass-inner-bevel), 0 14px 32px rgba(36, 20, 38, 0.16);
	}
	
	.link-card-wrapper:active .link-card {
		transform: scale(0.97);
	}
	
	.avatar-container {
		position: relative;
		width: 64px;
		height: 64px;
		flex-shrink: 0;
	}

	.avatar-fallback {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		border: 1px solid var(--panel-line);
		border-radius: 50%;
		background: linear-gradient(145deg, rgb(241 155 197 / 0.28), rgb(69 39 82 / 0.68));
		color: var(--rose-ink);
		font: 600 1.65rem/1 var(--font-display);
	}
	
	.link-avatar {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
		border: 2px solid var(--glass-border);
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
		transition: transform 200ms var(--ease-spring), border-color 150ms var(--ease-out);
		z-index: 2;
		position: relative;
	}
	
	.link-card-wrapper:hover .link-avatar {
		transform: scale(1.08) rotate(5deg);
		border-color: var(--accent);
	}
	
	.avatar-glow {
		position: absolute;
		top: -4px;
		left: -4px;
		right: -4px;
		bottom: -4px;
		background: radial-gradient(circle, rgba(var(--accent-color), 0.4) 0%, transparent 70%);
		border-radius: 50%;
		opacity: 0;
		filter: blur(4px);
		transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
		z-index: 1;
	}
	
	.link-card-wrapper:hover .avatar-glow {
		opacity: 1;
		transform: scale(1.15);
	}
	
	.link-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
		z-index: 2;
		flex: 1;
	}
	
	.link-name {
		margin: 0;
		font: 650 1.35rem/1.3 var(--font-display);
		font-weight: 700;
		color: var(--text-color);
		transition: color 150ms var(--ease-out);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	
	.link-card-wrapper:hover .link-name {
		color: var(--accent);
	}
	
	.link-description {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.visit-icon {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		flex: 0 0 auto;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.26);
		box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.3), 0 2px 8px rgba(16, 10, 28, 0.18);
		color: var(--text-color);
		font-size: 1.05rem;
		transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out), transform 180ms var(--ease-spring);
		z-index: 2;
	}

	.link-card-wrapper:hover .visit-icon {
		color: var(--accent);
		background: rgba(var(--accent-color), 0.14);
		transform: translate(2px, -2px);
	}
	
	@media (max-width: 480px) {
		.links-grid {
			grid-template-columns: 1fr;
		}
		.link-card { padding: 1.05rem; gap: 0.9rem; }
		.avatar-container { width: 56px; height: 56px; }
		.visit-icon { width: 32px; height: 32px; }
	}
</style>
