---
import Layout from '../layouts/PageLayout.astro';
import { REPOSITORY_URL } from '../consts';

const links = [
	{
		name: "tukwhy",
		url: "https://tukwhy.top",
		avatar: "https://tukwhy.top/medias/avatar.jpg",
		description: "西郊有密林，助君出重围"
	}
];
---

<Layout
	title="友情链接"
	description="一些值得常去看看的朋友与站点。"
>
	<p class="links-intro">
		欢迎交换友链！你可以在“关于”页面找到我的联系方式，或者在 <a href={REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub 仓库</a>提交 PR。
	</p>
	
	<div class="links-grid">
		{links.map(link => (
			<a href={link.url} target="_blank" rel="noopener noreferrer" class="link-card-wrapper">
				<div class="link-card">
					<div class="avatar-container">
						<img src={link.avatar} alt={link.name} class="link-avatar" loading="lazy" />
						<div class="avatar-glow"></div>
					</div>
					<div class="link-info">
						<h3 class="link-name">{link.name}</h3>
						<p class="link-description">{link.description}</p>
					</div>
					<span class="visit-icon" aria-hidden="true">↗</span>
				</div>
			</a>
		))}
	</div>
</Layout>

<style>
	.links-intro {
		text-align: center;
		color: var(--text-muted);
		margin-bottom: 2.5rem;
		font-size: 1.05rem;
	}
	
	.links-grid {
		display: grid;
		grid-template-columns: minmax(0, 620px);
		justify-content: center;
		gap: 1.5rem;
		margin: 1rem auto 0;
	}
	
	.link-card-wrapper {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	
	.link-card {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.3rem 1.4rem;
		min-height: 112px;
		box-sizing: border-box;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.28);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.32), 0 10px 30px rgba(42, 29, 53, 0.1);
		transition: transform 200ms var(--ease-spring), background-color 200ms var(--ease-out), border-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
		position: relative;
		overflow: hidden;
	}
	
	.link-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: radial-gradient(800px circle at var(--x, 0px) var(--y, 0px), rgba(var(--accent-color), 0.08), transparent 40%);
		opacity: 0;
		transition: opacity 200ms var(--ease-out);
		pointer-events: none;
		z-index: 1;
	}
	
	.link-card:hover::before {
		opacity: 1;
	}
	
	.link-card-wrapper:hover .link-card {
		transform: translateY(-3px);
		background: var(--card-hover-bg);
		border-color: rgba(255, 255, 255, 0.42);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42), 0 14px 32px rgba(42, 29, 53, 0.15), 0 0 0 1px rgba(var(--accent-color), 0.12);
	}
	
	.link-card-wrapper:active .link-card {
		transform: scale(0.97);
	}
	
	.avatar-container {
		position: relative;
		width: 64px;
		height: 64px;
		flex-shrink: 0;
	}
	
	.link-avatar {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
		border: 2px solid var(--glass-border);
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
		transition: transform 200ms var(--ease-spring), border-color 150ms var(--ease-out);
		z-index: 2;
		position: relative;
	}
	
	.link-card-wrapper:hover .link-avatar {
		transform: scale(1.08) rotate(5deg);
		border-color: var(--accent);
	}
	
	.avatar-glow {
		position: absolute;
		top: -4px;
		left: -4px;
		right: -4px;
		bottom: -4px;
		background: radial-gradient(circle, rgba(var(--accent-color), 0.4) 0%, transparent 70%);
		border-radius: 50%;
		opacity: 0;
		filter: blur(4px);
		transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
		z-index: 1;
	}
	
	.link-card-wrapper:hover .avatar-glow {
		opacity: 1;
		transform: scale(1.15);
	}
	
	.link-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
		z-index: 2;
		flex: 1;
	}
	
	.link-name {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text-color);
		transition: color 150ms var(--ease-out);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	
	.link-card-wrapper:hover .link-name {
		color: var(--accent);
	}
	
	.link-description {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.visit-icon {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		flex: 0 0 auto;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: var(--text-color);
		font-size: 1.05rem;
		transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out), transform 180ms var(--ease-spring);
		z-index: 2;
	}

	.link-card-wrapper:hover .visit-icon {
		color: var(--accent);
		background: rgba(var(--accent-color), 0.14);
		transform: translate(2px, -2px);
	}
	
	@media (max-width: 480px) {
		.links-grid {
			grid-template-columns: 1fr;
		}
		.link-card { padding: 1.05rem; gap: 0.9rem; }
		.avatar-container { width: 56px; height: 56px; }
		.visit-icon { width: 32px; height: 32px; }
	}
</style>

<script>
	// Add hover spotlight effect tracking cursor
	const cards = document.querySelectorAll('.link-card') as NodeListOf<HTMLDivElement>;
	cards.forEach(card => {
		card.addEventListener('mousemove', (e) => {
			const rect = card.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			card.style.setProperty('--x', `${x}px`);
			card.style.setProperty('--y', `${y}px`);
		});
	});
</script>
