---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import PostTitle from '../../components/PostTitle.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.archive-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: var(--layout-gap);
				padding: 0.35rem 0.2rem 0.75rem;
				border-bottom: 1px solid var(--panel-line);
			}
			.archive-count {
				padding: 0.25rem 0.6rem;
				border: 1px solid var(--panel-line);
				border-radius: var(--liquid-glass-control-radius);
				corner-shape: superellipse(var(--liquid-glass-corner));
				background: rgb(35 19 44 / 0.66);
				color: var(--text-color);
				white-space: nowrap;
				font-size: 0.86rem;
			}
			.archive-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: var(--layout-gap);
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.archive-grid li {
				padding: 0;
				overflow: hidden;
			}
			.archive-grid li:first-child { grid-column: 1 / -1; }
			.archive-grid a { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
			.archive-grid a:focus-visible { outline-offset: -5px; }
			.archive-grid li:first-child a:has(> img) { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr); }
			.archive-grid img {
				display: block;
				width: 100%;
				aspect-ratio: 1.72;
				height: auto;
				object-fit: cover;
				border-radius: 0;
			}
			.archive-grid li:first-child img { height: 100%; max-height: 360px; min-height: 270px; }
			.content { padding: clamp(1.05rem, 2.6vw, 1.7rem); }
			.archive-grid li:first-child .content {
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: clamp(1.2rem, 4vw, 2.8rem);
			}
			.title {
				margin: 0.48rem 0 0;
				font: 650 clamp(1.2rem, 2.3vw, 1.73rem)/1.28 var(--font-display);
				text-wrap: balance;
				transition: color 150ms var(--ease-out);
			}
			.archive-grid li:first-child .title { font-size: clamp(2rem, 4.4vw, 3.2rem); }
			.archive-grid a:hover .title { color: var(--rose-ink); }
			.date { margin: 0; color: var(--cool-ink); font-size: 0.86rem; font-variant-numeric: tabular-nums; }
			.description { margin: 0.65rem 0 0; color: var(--text-muted); font-size: 0.95rem; line-height: 1.65; text-wrap: pretty; }
			@media (max-width: 800px) {
				.archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
			}
			@media (max-width: 600px) {
				.archive-grid { grid-template-columns: minmax(0, 1fr); }
				.archive-grid li:first-child a:has(> img) { display: flex; }
				.archive-grid li:first-child img { min-height: 0; height: auto; }
				.archive-grid li:first-child .content { align-self: stretch; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section aria-labelledby="archive-title">
				<div class="archive-heading">
					<h1 class="editorial-title" id="archive-title">文章</h1>
					<span class="archive-count">{posts.length} 篇文章</span>
				</div>
				<ul class="archive-grid">
					{
						posts.map((post) => (
							<li class="glass-card glass-card-hover">
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<div class="content">
										<p class="date">
											{post.data.updatedDate ? '更新于' : '发表于'} <FormattedDate date={post.data.updatedDate ?? post.data.pubDate} />
										</p>
										<h2 class="title"><PostTitle title={post.data.title} breakAfter={post.data.titleBreakAfter} /></h2>
										{post.data.description && (
											<p class="description">{post.data.description}</p>
										)}
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
