---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CONTACT_EMAIL, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE, CURRENT_LOCATION } from '../consts';
import avatarImage from '../assets/avatar.png';
import xianGlobe from '../assets/xian-globe.webp';

const allPosts = await getCollection('blog');
const posts = [...allPosts]
	.sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf())
	.slice(0, 3);
const featuredPost = allPosts.find((post) => post.id === 'rememberance') ?? posts[0];
const searchPosts = allPosts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	url: `/blog/${post.id}/`,
}));

---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.widget-grid { display: grid; gap: var(--layout-gap); }
			.home-hero,
			.home-journal {
				display: grid;
				gap: var(--layout-gap);
			}
			.home-hero { grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); }
			.home-journal { grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); }
			.home-hero > *, .home-journal > * { min-width: 0; }

			.search-widget { position: relative; z-index: 3; min-width: 0; }
			.search-inner {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.62rem 0.85rem;
				border: 1px solid var(--panel-line);
				border-radius: 12px;
				background: rgb(22 13 29 / 0.36);
				color: var(--rose-ink);
			}
			.search-inner:focus-within { border-color: var(--rose-ink); }
			.search-inner svg { flex: 0 0 auto; }
			.search-input {
				width: 100%;
				min-width: 0;
				border: 0;
				outline: 0;
				background: transparent;
				color: var(--text-color);
				font: inherit;
				font-size: 0.92rem;
			}
			.search-input::placeholder { color: var(--text-muted); }

			.search-results {
				display: none;
				position: absolute;
				top: calc(100% + 0.55rem);
				left: 0;
				right: 0;
				padding: 0.55rem;
				border: 1px solid rgba(255, 255, 255, 0.24);
				border-radius: 20px;
				background: rgba(28, 22, 42, 0.62);
				box-shadow: var(--glass-inner-bevel), 0 20px 50px rgba(10, 6, 20, 0.34);
				-webkit-backdrop-filter: blur(1px) saturate(120%);
				backdrop-filter: blur(1px) saturate(120%);
			}
			:root[data-theme="dark"] .search-results {
				background: rgba(16, 14, 26, 0.72);
				border-color: rgba(255, 255, 255, 0.18);
				box-shadow: var(--glass-inner-bevel), 0 22px 54px rgba(4, 3, 10, 0.48);
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) .search-results {
					background: rgba(16, 14, 26, 0.72);
					border-color: rgba(255, 255, 255, 0.18);
					box-shadow: var(--glass-inner-bevel), 0 22px 54px rgba(4, 3, 10, 0.48);
				}
			}
			.search-results.visible { display: block; }
			.search-result-list { display: grid; gap: 0.25rem; }
			.search-result {
				display: block;
				padding: 0.7rem 0.8rem;
				border-radius: 10px;
				color: var(--text-color);
				text-decoration: none;
			}
			.search-result:hover,
			.search-result:focus { background: rgba(var(--accent-color), 0.12); }
			.search-result strong { display: block; }
			.search-result span {
				display: block;
				margin-top: 0.15rem;
				color: var(--text-muted);
				font-size: 0.85rem;
			}
			.search-empty { margin: 0; padding: 0.75rem; color: var(--text-muted); }

			.profile-card {
				display: flex;
				flex-direction: column;
				justify-content: center;
				min-height: 390px;
				padding: clamp(1.4rem, 3.2vw, 2.8rem);
				background: linear-gradient(145deg, rgb(104 44 79 / 0.24), rgb(38 24 58 / 0.30)), var(--material-thin);
			}
			.profile-title-link { color: inherit; text-decoration: none; }
			.profile-title-link:hover { color: var(--rose-ink); }
			.profile-title-link span { color: var(--rose-ink); }
			.profile-top { display: grid; gap: 1.1rem; justify-items: start; }
			.profile-avatar {
				width: 70px;
				height: 70px;
				border: 2px solid rgb(255 234 245 / 0.65);
				border-radius: 50%;
				object-fit: cover;
				box-shadow: 0 0 0 5px rgb(255 228 243 / 0.08), 0 8px 22px rgb(27 14 33 / 0.32);
			}
			.profile-info h1 {
				margin: 0;
				font: 500 clamp(2.15rem, 5.1vw, 4.25rem)/1.03 var(--font-display);
				letter-spacing: -0.06em;
				text-wrap: balance;
			}
			.profile-info p { margin: 0.85rem 0 0; font-size: 0.98rem; color: var(--text-muted); }
			.profile-signature {
				margin: 1.2rem 0;
				padding-left: 0.8rem;
				border-left: 2px solid var(--warm-ink);
				font: 500 1rem/1.65 var(--font-display);
				color: var(--warm-ink);
			}
			.profile-bottom {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				align-items: center;
				gap: 0.8rem;
				padding-top: 0.85rem;
				border-top: 1px solid var(--panel-line);
			}
			.profile-stats, .profile-socials { display: flex; align-items: center; }
			.profile-stats { gap: clamp(0.7rem, 1.75vw, 1.5rem); }
			.profile-socials { gap: 0.4rem; }
			.stat-val { display: block; color: var(--rose-ink); font-size: 1.12rem; font-weight: 720; line-height: 1.2; }
			.stat-lbl { color: var(--text-muted); font-size: 0.81rem; }
			.social-btn {
				display: grid;
				place-items: center;
				width: 40px;
				height: 40px;
				border: 1px solid var(--panel-line);
				border-radius: 50%;
				background: rgb(245 219 238 / 0.07);
				color: var(--text-color);
				transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out);
			}
			.social-btn:hover { background: var(--rose-ink); color: #342139; }

			/* Location widget uses the same material system as the surrounding cards. */
			.map-widget {
				min-height: 255px;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				position: relative;
				overflow: hidden;
				isolation: isolate;
				background: radial-gradient(ellipse at 50% 36%, rgb(48 34 61 / 0.74), rgb(44 28 55 / 0.48) 72%, transparent),
					var(--journal-glass);
			}
			/* SVG Map */
			.svg-map-wrapper {
				flex-grow: 1;
				position: relative;
				overflow: hidden;
				min-height: 184px;
				margin: -0.75rem -0.5rem -0.2rem;
				-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
				mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
			}
			.svg-map-wrapper svg {
				display: block;
				width: 100%;
				height: 100%;
				overflow: hidden;
				shape-rendering: geometricPrecision;
			}
			.map-land {
				display: none;
			}
			:global(.country-path) {
				fill: none !important;
				stroke: none !important;
				pointer-events: none !important;
			}
			.dot-grid-image {
				filter: drop-shadow(0 0 7px rgb(207 171 218 / 0.17));
				pointer-events: none;
			}
			.city-marker {
				fill: #fff1cc;
				stroke: #ffe0a2;
				stroke-width: 2.6;
				filter: drop-shadow(0 0 6px #ffcf75) drop-shadow(0 0 11px rgb(255 173 85 / 0.72));
				animation: pulse-city 2s infinite;
				transform-box: fill-box;
				transform-origin: center;
			}
			.city-halo {
				fill: rgb(255 185 99 / 0.34);
				filter: drop-shadow(0 0 11px rgb(255 169 71 / 0.68));
			}
			.city-core-glow {
				fill: rgb(255 218 151 / 0.54);
				filter: blur(2px);
			}
			.city-spark {
				stroke: rgb(255 226 170 / 0.92);
				stroke-width: 1.35;
				stroke-linecap: round;
				filter: drop-shadow(0 0 4px rgb(255 186 91 / 0.85));
				animation: sparkle-city 2.4s ease-in-out infinite;
				transform-box: fill-box;
				transform-origin: center;
			}
			.city-ring {
				fill: none;
				stroke: #ffc46d;
				stroke-width: 1.5;
				animation: expand-ring 2s infinite;
				transform-box: fill-box;
				transform-origin: center;
			}
			@keyframes pulse-city {
				0%, 100% { opacity: 1; transform: scale(0.92); }
				50% { opacity: 0.82; transform: scale(1.12); }
			}
			@keyframes sparkle-city {
				0%, 100% { opacity: 0.48; transform: scale(0.82) rotate(0deg); }
				50% { opacity: 1; transform: scale(1.12) rotate(8deg); }
			}
			@keyframes expand-ring {
				0% { transform: scale(1); opacity: 0.8; }
				100% { transform: scale(3.5); opacity: 0; }
			}

			.location-footer {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				position: relative;
				z-index: 2;
				font-size: 0.98rem;
				padding-top: 0.65rem;
				border-top: 1px solid var(--cool-line);
			}
			.location-pin {
				width: 18px;
				height: 18px;
				color: var(--warm-ink);
				filter: drop-shadow(0 0 5px rgb(255 185 99 / 0.34));
				flex: 0 0 auto;
			}
			.location-text {
				color: var(--map-text-color);
				font-weight: 500;
				text-shadow: var(--surface-text-shadow);
			}
			.location-text strong {
				color: var(--warm-ink);
				font-weight: 700;
			}

			.featured-widget {
				display: grid;
				grid-template-rows: 1fr auto auto;
				gap: 0.75rem;
				min-height: 390px;
				padding: clamp(1.25rem, 2.8vw, 2.15rem);
				overflow: hidden;
				color: var(--text-color);
				text-decoration: none;
				background: var(--hero-glass);
			}
			.featured-visual { position: absolute; inset: 0; pointer-events: none; }
			.featured-visual::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgb(26 13 37 / 0.25), transparent 25%, rgb(21 13 33 / 0.22) 47%, rgb(22 13 33 / 0.88) 100%);
			}
			.featured-img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 48%;
				transition: transform 240ms var(--ease-out);
			}
			.featured-widget:hover { opacity: 1; }
			.featured-widget:hover .featured-img { transform: scale(1.025); }
			.featured-widget[data-glass-photo] {
				-webkit-backdrop-filter: none;
				backdrop-filter: none;
			}
			.featured-tag, .featured-copy, .featured-bottom { position: relative; z-index: 1; }
			.featured-tag {
				align-self: start;
				justify-self: start;
				padding: 0.35rem 0.65rem;
				border: 1px solid rgb(255 218 239 / 0.52);
				border-radius: 8px;
				background: rgb(41 24 49 / 0.60);
				color: var(--rose-ink);
				font-size: 0.69rem;
				font-weight: 720;
				letter-spacing: 0.12em;
			}
			.featured-copy h2 { margin: 0; font: 600 clamp(1.85rem, 3.6vw, 2.95rem)/1.17 var(--font-display); text-wrap: balance; }
			.featured-copy p { margin: 0.45rem 0 0; color: var(--text-muted); font-size: 1rem; }
			.featured-bottom {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				align-items: center;
				gap: 0.45rem 0.8rem;
				padding-top: 0.68rem;
				border-top: 1px solid rgb(255 235 248 / 0.24);
				color: var(--text-muted);
				font-size: 0.85rem;
			}
			.featured-bottom span:first-child { color: var(--rose-ink); font-weight: 700; }
			.featured-bottom :global(time) { color: var(--cool-ink); font-variant-numeric: tabular-nums; }
			.featured-widget:hover .featured-bottom span:first-child { text-decoration: underline; }

			.recent-posts-widget {
				padding: clamp(1.2rem, 2.3vw, 1.75rem);
				background: linear-gradient(rgb(25 17 37 / 0.17), rgb(25 17 37 / 0.23)), var(--journal-glass);
			}
			.recent-posts-widget:focus-within { z-index: 3; }
			.journal-header {
				display: grid;
				grid-template-columns: auto minmax(0, 16rem);
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}
			.widget-title { margin: 0; display: flex; align-items: center; gap: 0.55rem; font-size: 1.22rem; }
			.widget-title svg { color: var(--rose-ink); }
			.post-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.7rem;
				padding: 0.76rem 0.35rem;
				border-top: 1px solid var(--panel-line);
				text-decoration: none;
			}
			.post-title-link { color: var(--text-color); font-size: 0.97rem; font-weight: 680; }
			.post-row:hover, .post-row:focus-visible { background: rgb(29 20 42 / 0.20); }
			.post-row:hover .post-title-link { color: var(--rose-ink); }
			.post-meta-tag { color: var(--cool-ink); white-space: nowrap; font-size: 0.82rem; font-variant-numeric: tabular-nums; }

			.home-utility { padding: 1rem clamp(1.15rem, 2.5vw, 1.9rem); background: linear-gradient(rgb(23 17 37 / 0.25), rgb(23 17 37 / 0.28)), var(--journal-glass); }
			.utility-details,
			.footer-bar {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				align-items: center;
				gap: 0.75rem 1.25rem;
			}
			.theme-widget { display: flex; align-items: center; gap: 0.65rem; }
			.theme-circle {
				display: grid;
				place-items: center;
				width: 37px;
				height: 37px;
				border: 1px solid rgb(255 219 240 / 0.35);
				border-radius: 50%;
				background: rgb(247 176 210 / 0.13);
				color: var(--rose-ink);
			}
			.theme-circle svg { width: 18px; height: 18px; }
			.theme-circle .moon-svg, :root[data-theme="dark"] .theme-circle .sun-svg { display: none; }
			:root[data-theme="dark"] .theme-circle .moon-svg { display: block; }
			.theme-widget h4 { margin: 0; font-size: 0.86rem; }
			.theme-widget p { margin: 0; font-size: 0.8rem; color: var(--text-muted); }
			.tech-widget { display: flex; flex-wrap: wrap; gap: 0.4rem; }
			.tech-badge {
				padding: 0.27rem 0.52rem;
				border: 1px solid var(--cool-line);
				border-radius: 6px;
				color: var(--cool-ink);
				font-size: 0.78rem;
			}
			.footer-bar { margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px solid var(--panel-line); }

			.footer-left {
				display: flex;
				align-items: center;
				gap: 1.2rem;
			}

			/* Retro Nixie Tube Clock */
			.nixie-clock {
				display: inline-flex;
				align-items: center;
				gap: 2px;
				background: rgba(7, 8, 8, 0.96);
				border: 1px solid rgba(255, 125, 35, 0.08);
				border-radius: 7px;
				padding: 4px 7px;
				box-shadow: inset 0 0 9px rgba(0, 0, 0, 0.96), 0 2px 8px rgba(0, 0, 0, 0.34);
				font-family: 'Courier New', Courier, monospace;
			}
			.nixie-tube {
				position: relative;
				width: 16px;
				height: 30px;
				background: radial-gradient(ellipse at center, rgba(42, 19, 4, 0.72) 0%, rgba(9, 8, 6, 0.97) 68%, #050505 100%);
				border: 1px solid rgba(255, 126, 38, 0.07);
				border-radius: 3px;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.92);
			}
			.nixie-tube::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-image: repeating-linear-gradient(to bottom, rgba(255, 151, 63, 0.06) 0 1px, transparent 1px 3px);
				z-index: 1;
				pointer-events: none;
			}
			.nixie-num {
				font-size: 1.18rem;
				font-weight: 700;
				color: #ff7a0a;
				text-shadow: 
					0 0 2px #ff4c00,
					0 0 5px rgba(255, 102, 0, 0.88),
					0 0 9px rgba(255, 91, 0, 0.5);
				z-index: 2;
				position: relative;
				line-height: 1;
			}
			.nixie-colon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 5px;
			}
			.nixie-dot {
				font-size: 1rem;
				font-weight: 800;
				color: #ff7a0a;
				text-shadow: 
					0 0 2px #ff4c00,
					0 0 5px rgba(255, 102, 0, 0.8);
				opacity: 0.82;
			}
			
			.runtime-wrapper {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
			}
			.status-pulse {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background-color: #10b981;
				box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
				animation: pulse 2s infinite;
			}
			@keyframes pulse {
				0% {
					transform: scale(0.95);
					box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
				}
				70% {
					transform: scale(1);
					box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
				}
				100% {
					transform: scale(0.95);
					box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
				}
			}

			.footer-right {
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.tech-badges-list {
				display: flex;
				gap: 0.5rem;
			}
			.tech-badge-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.2rem 0.6rem;
				border-radius: 8px;
				font-size: 0.75rem;
				font-weight: 600;
				white-space: nowrap;
				border: 1px solid rgba(var(--accent-color), 0.15);
				background: rgba(var(--accent-color), 0.05);
				color: var(--text-color);
				transition: transform 150ms var(--ease-out), background-color 150ms var(--ease-out);
			}
			.tech-badge-pill:hover {
				transform: translateY(-1px);
			}
			.tech-badge-pill .dot-indicator {
				width: 6px;
				height: 6px;
				border-radius: 50%;
			}
			.tech-badge-pill.astro-pill {
				border-color: rgba(255, 94, 0, 0.28);
				background: rgba(255, 94, 0, 0.12);
				color: #ff9c59;
			}
			.tech-badge-pill.vite-pill {
				border-color: rgba(129, 140, 248, 0.3);
				background: rgba(100, 108, 255, 0.14);
				color: #9aa4ff;
			}
			.tech-badge-pill.react-pill {
				border-color: rgba(56, 189, 248, 0.28);
				background: rgba(8, 126, 164, 0.14);
				color: #38bdf8;
			}
			.icp-link {
				font-size: 0.8rem;
				white-space: nowrap;
				color: var(--text-muted);
				transition: color 150ms var(--ease-out);
			}
			.icp-link:hover {
				color: var(--accent);
			}

			@media (max-width: 800px) {
				.home-hero, .home-journal { grid-template-columns: minmax(0, 1fr); }
				.profile-card { min-height: 0; }
				.featured-widget { min-height: 320px; }
				.map-widget { min-height: 245px; }
			}
			@media (max-width: 480px) {
				.featured-widget { min-height: 290px; }
				.journal-header { grid-template-columns: minmax(0, 1fr); }
				.post-row { align-items: start; flex-direction: column; gap: 0.1rem; padding-block: 0.6rem; }
				.footer-right, .footer-left { flex-wrap: wrap; gap: 0.55rem; }
				.tech-badges-list { flex-wrap: wrap; }
			}

			@media (prefers-reduced-motion: reduce) {
				.city-marker, .city-ring, .theme-circle .sun-svg, .theme-circle .moon-svg, .nixie-dot {
					animation: none !important;
				}
				.featured-img { transition: none; }
				.featured-widget:hover .featured-img { transform: none; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-main">
			<div class="widget-grid">
				<div class="home-hero">
					<div class="glass-card profile-card" data-glass-tier="intro">
						<div class="profile-top">
							<Image src={avatarImage} alt="Skittles 的头像" class="profile-avatar" width={160} height={160} format="webp" quality={80} />
							<div class="profile-info">
								<h1><a href="/about" class="profile-title-link">Hi, I'm <span>Skittles!</span></a></h1>
								<p>Grade 2024 student in EE, Xi'an Jiaotong University</p>
