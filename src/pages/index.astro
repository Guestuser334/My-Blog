---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTACT_EMAIL, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE, CURRENT_LOCATION } from '../consts';
import avatarImage from '../assets/avatar.png';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const featuredPost = allPosts.find((post) => post.id === 'rememberance') ?? posts[0];
const searchPosts = allPosts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	url: `/blog/${post.id}/`,
}));

const formatDate = (date: Date) => {
	const d = new Date(date);
	const y = d.getFullYear();
	const m = String(d.getMonth() + 1).padStart(2, '0');
	const day = String(d.getDate()).padStart(2, '0');
	return `${y}/${m}/${day}`;
};

const formatDateSpaced = (date: Date) => {
	const d = new Date(date);
	const y = d.getFullYear();
	const m = String(d.getMonth() + 1).padStart(2, '0');
	const day = String(d.getDate()).padStart(2, '0');
	return `${y} / ${m} / ${day}`;
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.widget-grid {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				padding: 1.5rem 0;
			}
			.row-flex {
				display: flex;
				gap: 1.5rem;
			}
			.w-58 { width: 58%; }
			.w-42 { width: 42%; }
			.w-35 { width: 35%; }
			.w-65 { width: 65%; }
			.w-100 { width: 100%; }

			/* Search Widget */
			.search-widget {
				padding: 0;
				z-index: 30;
			}
			.search-inner {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 1rem 1.5rem;
				color: rgba(255, 255, 255, 0.82);
				font-size: 1.05rem;
			}
			.search-inner svg {
				opacity: 0.9;
				flex: 0 0 auto;
			}
			.search-input {
				width: 100%;
				border: 0;
				outline: 0;
				background: transparent;
				color: #fff;
				font: inherit;
			}
			.search-input::placeholder { color: rgba(255, 255, 255, 0.7); }
			.search-results {
				display: none;
				position: absolute;
				top: calc(100% + 0.55rem);
				left: 0;
				right: 0;
				padding: 0.55rem;
				border: 1px solid rgba(255, 255, 255, 0.16);
				border-radius: 16px;
				background: rgba(24, 26, 38, 0.94);
				box-shadow: 0 18px 45px rgba(0, 0, 0, 0.3);
				-webkit-backdrop-filter: blur(20px);
				backdrop-filter: blur(20px);
			}
			.search-results.visible { display: grid; gap: 0.25rem; }
			.search-result {
				display: block;
				padding: 0.7rem 0.8rem;
				border-radius: 10px;
				color: #fff;
				text-decoration: none;
			}
			.search-result:hover,
			.search-result:focus { background: rgba(var(--accent-color), 0.16); }
			.search-result strong { display: block; }
			.search-result span {
				display: block;
				margin-top: 0.15rem;
				color: rgba(255, 255, 255, 0.68);
				font-size: 0.85rem;
			}
			.search-empty { margin: 0; padding: 0.75rem; color: rgba(255, 255, 255, 0.7); }
			}

			/* Profile Card */
			.profile-card {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				height: 320px;
				position: relative;
				top: 0;
				/* Hover animation defined via top property, shadow inherits from global */
				transition: top 200ms var(--ease-spring), box-shadow 200ms var(--ease-out), transform 150ms var(--ease-out);
			}
			
			.profile-card:hover {
				top: -4px;
				/* Add an accent shadow glow on hover on top of the global hover shadow */
				box-shadow: 
					inset 0 1px 1.5px rgba(255, 255, 255, 0.5),
					0 16px 40px rgba(0, 0, 0, 0.15), 
					0 0 1px 1px rgba(var(--accent-color), 0.3);
			}
			.profile-card:active {
				transform: scale(0.98);
			}
			.profile-title-link {
				color: inherit;
				text-decoration: none;
				outline: none;
			}
			.profile-title-link::after {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				z-index: 1;
				border-radius: 24px;
			}
			.profile-top {
				display: flex;
				gap: 1.65rem;
				align-items: center;
			}
			.profile-avatar {
				width: 112px;
				height: 112px;
				border-radius: 46% 54% 48% 52% / 51% 44% 56% 49%;
				object-fit: cover;
				border: 2px solid rgba(255, 255, 255, 0.42);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 12px 28px rgba(28, 20, 40, 0.2);
				transition: border-radius 600ms var(--ease-spring), transform 400ms var(--ease-spring), box-shadow 300ms var(--ease-out);
			}
			.profile-card:hover .profile-avatar {
				border-radius: 56% 44% 54% 46% / 43% 57% 43% 57%;
				transform: scale(1.045) rotate(-1deg);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65), 0 14px 34px rgba(var(--accent-color), 0.2);
			}
			.profile-info h2 {
				margin: 0 0 0.3rem 0;
				font-size: 1.7rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				font-family: var(--font-display);
				font-weight: 600;
			}
			.profile-info p {
				margin: 0;
				font-size: 1rem;
				color: var(--text-color);
				line-height: 1.5;
			}
			.profile-signature {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				margin: 0.9rem 0 0.15rem;
				padding-top: 0.8rem;
				border-top: 1px solid var(--map-divider);
				color: var(--text-color);
				font-size: 0.95rem;
				letter-spacing: 0.01em;
			}
			.profile-signature::before {
				content: '“';
				color: var(--accent);
				font-family: Georgia, serif;
				font-size: 1.8rem;
				line-height: 0.7;
			}
			.profile-signature::after {
				content: '”';
				margin-left: -0.28rem;
				color: var(--accent);
				font-family: Georgia, serif;
				font-size: 1.8rem;
				line-height: 0.7;
			}
			.profile-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 1rem;
			}
			.profile-stats {
				display: flex;
				gap: 1.5rem;
			}
			.stat-item {
				text-align: center;
			}
			.stat-val {
				font-size: 1.45rem;
				font-weight: 800;
				color: var(--accent);
				display: block;
			}
			.stat-lbl {
				font-size: 0.85rem;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.profile-socials {
				display: flex;
				gap: 0.6rem;
				position: relative;
				z-index: 2;
			}
			.social-btn {
				width: 38px;
				height: 38px;
				border-radius: 50%;
				background: rgba(var(--accent-color), 0.05);
				border: 1px solid rgba(var(--accent-color), 0.1);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--text-color);
				transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out), transform 150ms var(--ease-out), box-shadow 150ms var(--ease-out);
			}
			.social-btn:hover {
				background: var(--accent);
				color: white !important;
				transform: translateY(-2px);
				box-shadow: 0 4px 12px rgba(var(--accent-color), 0.35);
			}
			.social-btn:active {
				transform: scale(0.95);
			}

			/* Location widget uses the same material system as the surrounding cards. */
			.map-widget {
				height: 320px;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				position: relative;
				overflow: hidden;
				isolation: isolate;
			}
			/* SVG Map */
			.svg-map-wrapper {
				flex-grow: 1;
				position: relative;
				overflow: hidden;
				min-height: 245px;
				margin: -0.8rem -0.75rem -0.25rem;
				-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
				mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
			}
			.svg-map-wrapper svg {
				display: block;
				width: 100%;
				height: 100%;
				overflow: hidden;
				shape-rendering: geometricPrecision;
			}
			.map-land {
				display: none;
			}
			:global(.country-path) {
				fill: none !important;
				stroke: none !important;
				pointer-events: none !important;
			}
			:global(.map-dot) {
				fill: rgba(240, 220, 231, 0.32);
				transition: fill 200ms var(--ease-out);
			}
			:global(.map-dot.active-land) {
				fill: #ffd2bd !important;
				opacity: 1;
			}
			.city-marker {
				fill: #fff4d8;
				stroke: #ffffff;
				stroke-width: 2;
				filter: drop-shadow(0 0 7px #ffd1a9) drop-shadow(0 0 13px rgba(255, 198, 158, 0.78));
				animation: pulse-city 2s infinite;
				transform-box: fill-box;
				transform-origin: center;
			}
			.city-halo {
				fill: rgba(255, 205, 169, 0.34);
				filter: drop-shadow(0 0 13px rgba(255, 210, 178, 0.82));
			}
			.city-core-glow {
				fill: rgba(255, 243, 213, 0.44);
				filter: blur(2px);
			}
			.city-spark {
				stroke: rgba(255, 239, 205, 0.92);
				stroke-width: 1.35;
				stroke-linecap: round;
				filter: drop-shadow(0 0 4px rgba(255, 208, 166, 0.9));
				animation: sparkle-city 2.4s ease-in-out infinite;
				transform-box: fill-box;
				transform-origin: center;
			}
			.city-ring {
				fill: none;
				stroke: #ffd6b5;
				stroke-width: 1;
				animation: expand-ring 2s infinite;
				transform-box: fill-box;
				transform-origin: center;
			}
			@keyframes pulse-city {
				0%, 100% { opacity: 1; transform: scale(0.92); }
				50% { opacity: 0.82; transform: scale(1.12); }
			}
			@keyframes sparkle-city {
				0%, 100% { opacity: 0.48; transform: scale(0.82) rotate(0deg); }
				50% { opacity: 1; transform: scale(1.12) rotate(8deg); }
			}
			@keyframes expand-ring {
				0% { transform: scale(1); opacity: 0.8; }
				100% { transform: scale(3.5); opacity: 0; }
			}

			.location-footer {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				position: relative;
				z-index: 2;
				font-size: 0.98rem;
				padding-top: 0.7rem;
			}
			.location-pin {
				width: 18px;
				height: 18px;
				color: #e97b93;
				filter: drop-shadow(0 0 5px rgba(233, 123, 147, 0.38));
				flex: 0 0 auto;
			}
			.location-text {
				color: var(--map-text-color);
				font-weight: 500;
				text-shadow: var(--surface-text-shadow);
			}
			.location-text strong {
				color: #f19a8d;
				font-weight: 700;
			}

			/* Featured Post Card */
			.featured-widget {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				justify-content: space-between;
				color: inherit;
				text-decoration: none;
			}
			.featured-tag {
				font-size: 0.7rem;
				font-weight: 800;
				color: white;
				background: linear-gradient(135deg, var(--accent), #f43f5e);
				padding: 3px 8px;
				border-radius: 6px;
				align-self: flex-start;
				letter-spacing: 0.05em;
				text-transform: uppercase;
			}
			.featured-img {
				width: 100%;
				height: 160px;
				object-fit: cover;
				border-radius: 14px;
				border: 1px solid var(--glass-border);
			}
			.featured-widget h3 {
				margin: 0;
				font-size: 1.35rem;
				line-height: 1.3;
				color: var(--text-color);
				transition: color 150ms var(--ease-out);
			}
			.featured-widget:hover h3 {
				color: var(--accent);
			}
			.featured-widget p {
				font-size: 0.95rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.featured-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.9rem;
				color: var(--text-muted);
				margin-top: 0.5rem;
			}

			/* Right Grid Section (Posts List + Theme Widget) */
			.right-content-grid {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				height: 100%;
			}
			
			/* Recent Posts Widget */
			.recent-posts-widget {
				flex-grow: 1;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.widget-title {
				font-size: 1.25rem;
				font-weight: 800;
				margin: 0 0 0.5rem 0;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.post-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0.6rem 0.8rem;
				border-radius: 12px;
				transition: background-color 150ms var(--ease-out), transform 150ms var(--ease-out);
			}
			.post-row:hover {
				background: rgba(var(--accent-color), 0.05);
				transform: translateX(4px);
			}
			.post-row:active {
				transform: scale(0.98);
			}
			.post-title-link {
				color: var(--text-color);
				font-weight: 600;
				font-size: 1.05rem;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				max-width: 70%;
			}
			.post-row:hover .post-title-link {
				color: var(--accent);
			}
			.post-meta-tag {
				font-size: 0.9rem;
				color: var(--text-muted);
			}

			/* Bottom sub-row */
			.sub-row {
				display: flex;
				gap: 1.5rem;
			}
			.w-50 { width: 50%; }

			/* Theme Widget */
			.theme-widget {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 1.5rem 1rem;
				position: relative;
			}

			/* Theme Widget Icon (Sun & Moon) */
			.theme-circle {
				width: 50px;
				height: 50px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				background: linear-gradient(135deg, #ff5e62 0%, #ff9966 100%);
				box-shadow: 0 4px 15px rgba(255, 94, 98, 0.45);
				margin-bottom: 0.8rem;
				color: white;
				transition: transform 200ms var(--ease-spring), box-shadow 200ms var(--ease-out), background 300ms var(--ease-out);
			}
			.theme-circle .sun-svg {
				width: 24px;
				height: 24px;
				display: block;
				animation: spin 20s linear infinite;
			}
			.theme-circle .moon-svg {
				width: 22px;
				height: 22px;
				display: none;
			}
			.theme-widget:hover .theme-circle {
				transform: scale(1.1);
				box-shadow: 0 6px 20px rgba(255, 94, 98, 0.6);
			}
			.theme-widget:active .theme-circle {
				transform: scale(0.95);
			}
			
			/* Dark Mode styling */
			:root[data-theme="dark"] .theme-circle {
				background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
				box-shadow: 0 4px 15px rgba(241, 196, 15, 0.4);
			}
			:root[data-theme="dark"] .theme-circle .sun-svg {
				display: none;
			}
			:root[data-theme="dark"] .theme-circle .moon-svg {
				display: block;
				color: white;
				animation: float-moon 3s ease-in-out infinite;
			}
			:root[data-theme="dark"] .theme-widget:hover .theme-circle {
				box-shadow: 0 6px 20px rgba(241, 196, 15, 0.6);
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) .theme-circle {
					background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
					box-shadow: 0 4px 15px rgba(241, 196, 15, 0.4);
				}
				:root:not([data-theme="light"]) .theme-circle .sun-svg {
					display: none;
				}
				:root:not([data-theme="light"]) .theme-circle .moon-svg {
					display: block;
					color: white;
					animation: float-moon 3s ease-in-out infinite;
				}
				:root:not([data-theme="light"]) .theme-widget:hover .theme-circle {
					box-shadow: 0 6px 20px rgba(241, 196, 15, 0.6);
				}
			}
			@keyframes float-moon {
				0%, 100% { transform: translateY(0); }
				50% { transform: translateY(-2px); }
			}

			.theme-widget h4 {
				margin: 0 0 0.2rem 0;
				font-size: 1.08rem;
				font-weight: 700;
			}
			.theme-widget p {
				margin: 0;
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			/* Tech Stack Widget */
			.tech-widget {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-content: center;
				justify-content: center;
				padding: 1.2rem;
			}
			.tech-badge {
				font-size: 0.85rem;
				padding: 5px 10px;
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.15);
				border: 1px solid var(--glass-border);
				color: var(--text-color);
				font-weight: 600;
			}
			:root[data-theme="dark"] .tech-badge {
				background: rgba(68, 50, 84, 0.26);
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) .tech-badge {
					background: rgba(68, 50, 84, 0.26);
				}
			}

			/* Status / Footer bar */
			.footer-bar {
				padding: 1rem 2rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.9rem;
				color: var(--text-color);
			}
			
			.footer-left {
				display: flex;
				align-items: center;
				gap: 1.2rem;
			}

			/* Retro Nixie Tube Clock */
			.nixie-clock {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				background: #09090b;
				border: 2px solid rgba(255, 255, 255, 0.05);
				border-radius: 10px;
				padding: 4px 8px;
				box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.95), 0 3px 10px rgba(0, 0, 0, 0.4);
				font-family: 'Courier New', Courier, monospace;
			}
			.nixie-tube {
				position: relative;
				width: 20px;
				height: 34px;
				background: radial-gradient(circle at center, rgba(30, 16, 5, 0.95) 0%, rgba(5, 4, 4, 0.98) 100%);
				border: 1px solid rgba(255, 255, 255, 0.04);
				border-radius: 6px;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: inset 0 0 5px rgba(0,0,0,0.9);
			}
			.nixie-tube::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-image: 
					linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
				background-size: 2px 2px;
				z-index: 1;
				pointer-events: none;
			}
			.nixie-num {
				font-size: 1.35rem;
				font-weight: 700;
				color: #ff7700;
				text-shadow: 
					0 0 2px #ff3c00, 
					0 0 6px #ff7700, 
					0 0 12px rgba(255, 119, 0, 0.8);
				z-index: 2;
				position: relative;
				line-height: 1;
			}
			.nixie-colon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 6px;
			}
			.nixie-dot {
				font-size: 1.2rem;
				font-weight: 800;
				color: #ff7700;
				text-shadow: 
					0 0 2px #ff3c00, 
					0 0 6px #ff7700;
				animation: nixie-blink 1s step-end infinite;
			}
			@keyframes nixie-blink {
				from, to { opacity: 1; }
				50% { opacity: 0.15; }
			}
			
			.runtime-wrapper {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--text-muted);
			}
			.status-pulse {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background-color: #10b981;
				box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
				animation: pulse 2s infinite;
			}
			@keyframes pulse {
				0% {
					transform: scale(0.95);
					box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
				}
				70% {
					transform: scale(1);
					box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
				}
				100% {
					transform: scale(0.95);
					box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
				}
			}

			.footer-right {
				display: flex;
				align-items: center;
				gap: 1.5rem;
			}
			.tech-badges-list {
				display: flex;
				gap: 0.5rem;
			}
			.tech-badge-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.2rem 0.6rem;
				border-radius: 8px;
				font-size: 0.75rem;
				font-weight: 600;
				border: 1px solid rgba(var(--accent-color), 0.15);
				background: rgba(var(--accent-color), 0.05);
				color: var(--text-color);
				transition: transform 150ms var(--ease-out), background-color 150ms var(--ease-out);
			}
			.tech-badge-pill:hover {
				transform: translateY(-1px);
			}
			.tech-badge-pill .dot-indicator {
				width: 6px;
				height: 6px;
				border-radius: 50%;
			}
			.tech-badge-pill.astro-pill {
				border-color: rgba(255, 94, 0, 0.2);
				background: rgba(255, 94, 0, 0.08);
				color: #e65c00;
			}
			:root[data-theme="dark"] .tech-badge-pill.astro-pill {
				color: #ff8533;
			}
			.tech-badge-pill.vite-pill {
				border-color: rgba(100, 108, 255, 0.2);
				background: rgba(100, 108, 255, 0.08);
				color: #4f46e5;
			}
			:root[data-theme="dark"] .tech-badge-pill.vite-pill {
				color: #818cf8;
			}
			.tech-badge-pill.react-pill {
				border-color: rgba(8, 126, 164, 0.2);
				background: rgba(8, 126, 164, 0.08);
				color: #087ea4;
			}
			:root[data-theme="dark"] .tech-badge-pill.react-pill {
				color: #22d3ee;
			}
			.icp-link {
				font-size: 0.8rem;
				color: var(--text-muted);
				transition: color 150ms var(--ease-out);
			}
			.icp-link:hover {
				color: var(--accent);
			}

			/* Keyframes */
			@keyframes spin {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}
			@keyframes blink {
				from, to { border-color: transparent }
				50% { border-color: var(--accent); }
			}

			/* Responsive styling */
			@media (max-width: 768px) {
				.row-flex {
					flex-direction: column;
					gap: 1rem;
				}
				.w-58, .w-42, .w-35, .w-65, .w-50 {
					width: 100% !important;
				}
				.glass-card {
					padding: 1.2rem !important; /* more breathing room on mobile */
				}
				
				/* Profile Card Mobile Optimization */
				.profile-card {
					height: auto !important;
					padding-bottom: 1.5rem !important;
				}
				.profile-top {
					flex-direction: column;
					text-align: center;
					gap: 1rem;
				}
				.profile-avatar {
					margin: 0 auto;
					width: 104px;
					height: 104px;
				}
				.profile-info h2 {
					font-size: 1.5rem;
				}
				.profile-bottom {
					flex-direction: column;
					gap: 1.2rem;
					align-items: center;
					margin-top: 1.5rem;
				}
				.profile-signature {
					justify-content: center;
					text-align: left;
					margin-top: 1.1rem;
				}
				.profile-stats {
					width: 100%;
					justify-content: space-around;
					gap: 1rem;
				}
				
				/* Map Card Mobile Optimization */
				.map-widget {
					height: 290px !important;
				}
				
				/* Sub-row / Column Layout Stacking */
				.sub-row {
					flex-direction: column;
					gap: 1rem;
				}
				
				/* Footer Bar Mobile Optimization */
				.footer-bar {
					flex-direction: column;
					gap: 1.2rem;
					text-align: center;
					padding: 1.5rem 1rem !important;
				}
				.footer-left {
					flex-direction: column;
					align-items: center;
					gap: 0.6rem;
				}
				.footer-right {
					flex-direction: column;
					align-items: center;
					gap: 0.8rem;
				}
				.tech-badges-list {
					justify-content: center;
					flex-wrap: wrap;
					gap: 0.4rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.city-marker, .city-ring, .theme-circle .sun-svg, .theme-circle .moon-svg, .nixie-dot {
					animation: none !important;
				}
				.profile-avatar { transition: none; }
				.profile-card:hover .profile-avatar { transform: none; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="widget-grid">
				
				<!-- Search / Welcome Bar -->
				<form class="glass-card search-widget" id="site-search" role="search">
					<label class="search-inner" for="site-search-input">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input class="search-input" id="site-search-input" type="search" placeholder="搜索文章标题或简介…" autocomplete="off" aria-controls="search-results" />
					</label>
					<div class="search-results" id="search-results" aria-live="polite"></div>
				</form>

				<!-- Row 1: Profile + Music Player -->
				<div class="row-flex">
					<!-- Profile Card -->
					<div class="glass-card profile-card w-58">
						<div class="profile-card-noise"></div>
						<div class="profile-top">
							<Image src={avatarImage} alt="Skittles 的头像" class="profile-avatar" width={160} height={160} format="webp" quality={80} />
							<div class="profile-info">
								<h2><a href="/about" class="profile-title-link">Hi, I'm Skittles!</a></h2>
								<p>Grade 2024 student in EE, Xi'an Jiaotong University</p>
							</div>
						</div>
						<div class="profile-signature">独有南山桂花发，飞来飞去袭人裾。</div>
						<div class="profile-bottom">
							<div class="profile-stats">
								<div class="stat-item">
									<span class="stat-val">{allPosts.length}</span>
									<span class="stat-lbl">文章</span>
								</div>
								<div class="stat-item">
									<span class="stat-val">2026</span>
									<span class="stat-lbl">开始于</span>
								</div>
								<div class="stat-item">
									<span class="stat-val">RSS</span>
									<span class="stat-lbl">可订阅</span>
								</div>
							</div>
							<div class="profile-socials">
							<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
									</svg>
								</a>
							<a href="/rss.xml" class="social-btn" aria-label="RSS">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
									</svg>
								</a>
							<a href={`mailto:${CONTACT_EMAIL}`} class="social-btn" aria-label="Mail">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
										<polyline points="22,6 12,13 2,6"></polyline>
									</svg>
								</a>
							</div>
						</div>
					</div>

					<!-- Interactive Location Map Card - SVG based -->
					<div class="glass-card map-widget w-42" role="group" aria-label="My location: Xi'an">

						<!-- SVG World Map -->
						<div class="svg-map-wrapper">
							<svg id="world-map-svg" viewBox="0 0 1010 610" preserveAspectRatio="xMidYMin slice" xmlns="http://www.w3.org/2000/svg">
								<defs>
									<radialGradient id="earth-gradient" cx="50%" cy="50%" r="50%">
										<stop offset="0%" stop-color="rgba(87, 77, 123, 0.05)" />
										<stop offset="76%" stop-color="rgba(91, 72, 120, 0.11)" />
						<stop offset="94%" stop-color="rgba(229, 180, 198, 0.16)" />
						<stop offset="100%" stop-color="rgba(255, 224, 208, 0)" />
									</radialGradient>
									<linearGradient id="atmosphere-gradient" x1="8%" y1="82%" x2="90%" y2="12%">
										<stop stop-color="#e9a4c2" stop-opacity=".7" />
										<stop offset=".48" stop-color="#ffd5bd" stop-opacity=".82" />
										<stop offset="1" stop-color="#cabeea" stop-opacity=".58" />
									</linearGradient>
								</defs>
								<!-- High-fidelity country paths loaded dynamically at runtime -->
								<g id="map-paths-group"></g>
								
								<!-- Dynamic dot matrix grid container -->
								<g id="dot-grid-group"></g>
								
				<!-- Location marker - updated by JS -->
				<g id="city-marker-group" style="display: none;">
					<circle class="city-halo" id="city-halo" cx="0" cy="0" r="22"/>
					<circle class="city-core-glow" id="city-core-glow" cx="0" cy="0" r="12"/>
					<circle class="city-ring" id="city-ring" cx="0" cy="0" r="16"/>
					<g id="city-spark-position">
						<g class="city-spark">
							<path d="M0 -25V-18M0 18v7M-25 0h7M18 0h7M-17.5-17.5l5 5M12.5 12.5l5 5M17.5-17.5l-5 5M-12.5 12.5l-5 5" />
						</g>
					</g>
					<circle class="city-marker" id="city-dot" cx="0" cy="0" r="7"/>
				</g>
							</svg>
						</div>

						<!-- Current Location Info -->
						<div class="location-footer">
							<svg class="location-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
								<circle cx="12" cy="10" r="2.5"></circle>
							</svg>
							<span class="location-text">Currently in: <strong id="current-location-display">Xi'an</strong></span>
						</div>
					</div>
				</div>

				<!-- Row 3: Grid containing Featured Post + Right Side Widgets -->
				<div class="row-flex">
					<!-- Featured Post Card -->
					<a href={`/blog/${featuredPost.id}/`} class="glass-card glass-card-hover featured-widget w-35">
						<span class="featured-tag">FEATURED STORY</span>
						{featuredPost.data.heroImage && <Image src={featuredPost.data.heroImage} alt="Cover" class="featured-img" width={400} height={200} />}
						<div>
							<h3>{featuredPost.data.title}</h3>
							<p style="margin-top: 0.5rem;">{featuredPost.data.description}</p>
						</div>
						<div class="featured-bottom">
							<span>阅读全文 &rarr;</span>
							<span>{formatDate(featuredPost.data.pubDate)}</span>
						</div>
					</a>

					<!-- Right Columns Widget Grid -->
					<div class="w-65 right-content-grid">
						<!-- Recent Posts List -->
						<div class="glass-card recent-posts-widget">
							<h3 class="widget-title">
								<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
									<polyline points="14 2 14 8 20 8"></polyline>
									<line x1="16" y1="13" x2="8" y2="13"></line>
									<line x1="16" y1="17" x2="8" y2="17"></line>
									<polyline points="10 9 9 9 8 9"></polyline>
								</svg>
								最近发表
							</h3>
							{
								posts.map((post) => (
									<div class="post-row">
										<a href={`/blog/${post.id}/`} class="post-title-link">
											{post.data.title}
										</a>
										<span class="post-meta-tag">
											{formatDateSpaced(post.data.pubDate)}
										</span>
									</div>
								))
							}
						</div>

						<!-- Sub Row for widgets -->
						<div class="sub-row">
							<!-- Theme Display Widget -->
							<div class="glass-card theme-widget w-50">
								<div class="theme-circle">
									<!-- Light Mode Sun SVG -->
									<svg class="sun-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="5"></circle>
										<line x1="12" y1="1" x2="12" y2="3"></line>
										<line x1="12" y1="21" x2="12" y2="23"></line>
										<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
										<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
										<line x1="1" y1="12" x2="3" y2="12"></line>
										<line x1="21" y1="12" x2="23" y2="12"></line>
										<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
										<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
									</svg>
									<!-- Dark Mode Moon SVG -->
									<svg class="moon-svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
									</svg>
								</div>
								<h4 id="theme-status-title">日间模式</h4>
								<p id="theme-status-desc">落樱漫舞的清晨</p>
							</div>
							
							<!-- Tech Stack Tags Widget -->
							<div class="glass-card tech-widget w-50">
								<span class="tech-badge">Astro 7.0</span>
								<span class="tech-badge">Vite 6.0</span>
								<span class="tech-badge">MDX</span>
								<span class="tech-badge">Waline</span>
								<span class="tech-badge">TypeScript</span>
								<span class="tech-badge">Glassmorphism</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Row 4: Status / Footer info bar -->
				<div class="glass-card footer-bar w-100">
					<div class="footer-left">
						<div class="nixie-clock" id="nixie-clock">
							<div class="nixie-tube" id="nixie-h1"><span class="nixie-num">0</span></div>
							<div class="nixie-tube" id="nixie-h2"><span class="nixie-num">0</span></div>
							<div class="nixie-colon"><span class="nixie-dot">:</span></div>
							<div class="nixie-tube" id="nixie-m1"><span class="nixie-num">0</span></div>
							<div class="nixie-tube" id="nixie-m2"><span class="nixie-num">0</span></div>
							<div class="nixie-colon"><span class="nixie-dot">:</span></div>
							<div class="nixie-tube" id="nixie-s1"><span class="nixie-num">0</span></div>
							<div class="nixie-tube" id="nixie-s2"><span class="nixie-num">0</span></div>
						</div>
						<div class="runtime-wrapper">
							<span class="status-pulse"></span>
							<span>系统已稳定运行：<span id="runtime-counter">9天 11小时</span></span>
						</div>
					</div>
					<div class="footer-right">
						<div class="tech-badges-list">
							<span class="tech-badge-pill astro-pill">
								<span class="dot-indicator" style="background-color: #ff5e00;"></span>
								Astro 7.0
							</span>
							<span class="tech-badge-pill vite-pill">
								<span class="dot-indicator" style="background-color: #747bff;"></span>
								Vite 6.0
							</span>
							<span class="tech-badge-pill react-pill">
								<span class="dot-indicator" style="background-color: #38bdf8;"></span>
								Waline
							</span>
						</div>
						<a href="https://icp.gov.cn" target="_blank" class="icp-link">萌ICP备 20260240号</a>
					</div>
				</div>

			</div>
		</main>
		<Footer />

		<!-- Scripts for clock, status, lyrics, and theme states -->
		<script define:vars={{ CURRENT_LOCATION, searchPosts }}>
			const searchForm = document.getElementById('site-search');
			const searchInput = document.getElementById('site-search-input');
			const searchResults = document.getElementById('search-results');

			const closeSearch = () => searchResults?.classList.remove('visible');
			const renderSearchResults = (query) => {
				if (!searchResults) return;
				searchResults.replaceChildren();
				const normalized = query.trim().toLocaleLowerCase('zh-CN');
				if (!normalized) {
					closeSearch();
					return;
				}
				const matches = searchPosts.filter((post) => `${post.title} ${post.description}`.toLocaleLowerCase('zh-CN').includes(normalized)).slice(0, 6);
				if (!matches.length) {
					const empty = document.createElement('p');
					empty.className = 'search-empty';
					empty.textContent = '没有找到相关文章';
					searchResults.appendChild(empty);
				} else {
					matches.forEach((post) => {
						const link = document.createElement('a');
						link.className = 'search-result';
						link.href = post.url;
						const title = document.createElement('strong');
						title.textContent = post.title;
						const description = document.createElement('span');
						description.textContent = post.description;
						link.append(title, description);
						searchResults.appendChild(link);
					});
				}
				searchResults.classList.add('visible');
			};
			searchInput?.addEventListener('input', (event) => renderSearchResults(event.target.value));
			searchForm?.addEventListener('submit', (event) => {
				event.preventDefault();
				const firstResult = searchResults?.querySelector('a');
				if (firstResult) window.location.href = firstResult.href;
			});
			document.addEventListener('click', (event) => {
				if (!searchForm?.contains(event.target)) closeSearch();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') closeSearch();
			});

			// Live Nixie Clock
			const updateClock = () => {
				const now = new Date();
				const hours = String(now.getHours()).padStart(2, '0');
				const minutes = String(now.getMinutes()).padStart(2, '0');
				const seconds = String(now.getSeconds()).padStart(2, '0');
				
				const updateNixieDigit = (id, val) => {
					const el = document.getElementById(id);
					if (el) {
						const num = el.querySelector('.nixie-num');
						if (num && num.textContent !== val) {
							num.textContent = val;
						}
					}
				};

				updateNixieDigit('nixie-h1', hours[0]);
				updateNixieDigit('nixie-h2', hours[1]);
				updateNixieDigit('nixie-m1', minutes[0]);
				updateNixieDigit('nixie-m2', minutes[1]);
				updateNixieDigit('nixie-s1', seconds[0]);
				updateNixieDigit('nixie-s2', seconds[1]);
			};
			setInterval(updateClock, 1000);
			updateClock();

			// Uptime Counter
			const updateUptime = () => {
				const startDate = new Date('2026-07-05T00:00:00');
				const now = new Date();
				const diffMs = now.getTime() - startDate.getTime();
				
				const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
				const diffHours = Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
				const diffMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
				const diffSecs = Math.floor((diffMs % (1000 * 60)) / 1000);
				
				const counterEl = document.getElementById('runtime-counter');
				if (counterEl) {
					counterEl.textContent = `${diffDays}天 ${diffHours}小时 ${diffMins}分 ${diffSecs}秒`;
				}
			};
			setInterval(updateUptime, 1000);
			updateUptime();

			// 3. Dynamic Theme Widget Status Update
			const themeTitle = document.getElementById('theme-status-title');
			const themeDesc = document.getElementById('theme-status-desc');

			const updateThemeWidget = () => {
				const isDark = document.documentElement.getAttribute('data-theme') === 'dark' ||
					(!document.documentElement.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
				
				if (themeTitle && themeDesc) {
					if (isDark) {
						themeTitle.textContent = "夜间模式";
						themeDesc.textContent = "极光流溢的深夜";
					} else {
						themeTitle.textContent = "日间模式";
						themeDesc.textContent = "落樱漫舞的清晨";
					}
				}
			};

			// Listen for theme mutations
			const observer = new MutationObserver(updateThemeWidget);
			observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
			
			// Initial check
			updateThemeWidget();

			// 4. SVG World Map - Move city marker and dynamically render 3D dot-matrix globe
			(async () => {
				const svgMapContainer = document.getElementById('world-map-svg');
				const cityDot = document.getElementById('city-dot');
				const cityRing = document.getElementById('city-ring');
				const cityHalo = document.getElementById('city-halo');
				const cityCoreGlow = document.getElementById('city-core-glow');
				const citySparkPosition = document.getElementById('city-spark-position');
				const locationDisplay = document.getElementById('current-location-display');
				const gridGroup = document.getElementById('dot-grid-group');
				const cityMarkerGroup = document.getElementById('city-marker-group');

				const CITIES = {
					Beijing:        { coords: [116.4074, 39.9042], label: "Beijing" },
					Shanghai:       { coords: [121.4737, 31.2304], label: "Shanghai" },
					Shenzhen:       { coords: [114.0579, 22.5431], label: "Shenzhen" },
					Chengdu:        { coords: [104.0665, 30.5728], label: "Chengdu" },
					Xian:           { coords: [108.9402, 34.3416], label: "Xi'an" },
					Wuxi:           { coords: [120.3119, 31.4912], label: "Wuxi" },
					Tokyo:          { coords: [139.6917, 35.6895], label: "Tokyo" },
					Singapore:      { coords: [103.8198, 1.3521], label: "Singapore" },
					London:         { coords: [-0.1278, 51.5074], label: "London" },
					Paris:          { coords: [2.3522, 48.8566], label: "Paris" },
					"New York":     { coords: [-74.0060, 40.7128], label: "New York" },
					"San Francisco":{ coords: [-122.4194, 37.7749], label: "San Francisco" },
					Sydney:         { coords: [151.2093, -33.8688], label: "Sydney" }
				};

				const cityKey = CURRENT_LOCATION || 'Xian';
				const cityData = CITIES[cityKey] || CITIES.Xian;
				const [cityLon, cityLat] = cityData.coords;

				try {
					// Dynamically import D3.js and TopoJSON Client
					const d3 = await import('https://cdn.jsdelivr.net/npm/d3@7/+esm');
					const topojson = await import('https://cdn.jsdelivr.net/npm/topojson-client@3/+esm');
					if (!svgMapContainer || !gridGroup) return;

					// Fetch world TopoJSON (with sessionStorage caching for instant subsequent loads)
					let worldData;
					const worldCacheKey = 'worldTopoData50m';
					const cachedWorld = sessionStorage.getItem(worldCacheKey);
					if (cachedWorld) {
						worldData = JSON.parse(cachedWorld);
					} else {
						const res = await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json');
						worldData = await res.json();
						sessionStorage.setItem(worldCacheKey, JSON.stringify(worldData));
					}
					const landFeature = topojson.feature(worldData, worldData.objects.land);

					const width = 1010;
					const height = 610;
					const globeRadius = 430;
					
					// A raised northern viewpoint plus a subtle roll creates the slightly top-down angle.
					const cameraLat = 22;
					const cameraRoll = -8;
					
					// Anchor the sphere's top inside the SVG and keep almost a full hemisphere visible.
					const centerYOffset = globeRadius - height / 2 + 3;

					// Setup 3D Orthographic Projection with a gentle equatorial tilt
					const projection = d3.geoOrthographic()
						.scale(globeRadius)
						.translate([width / 2, height / 2 + centerYOffset])
						.rotate([-cityLon, -cameraLat, cameraRoll])
						.clipAngle(90);

					// --- ULTRA-FAST PERFORMANCE OPTIMIZATION ---
					// Render land to an offscreen canvas to avoid calling d3.geoContains 10,000+ times.
					// Canvas array lookup is O(1) and executes in microseconds vs milliseconds for Math.
					const canvas = document.createElement('canvas');
					canvas.width = 1010; // Max SVG X size
					canvas.height = 1010; // Max SVG Y size
					const ctx = canvas.getContext('2d', { willReadFrequently: true });
					const path = d3.geoPath().projection(projection).context(ctx);
					ctx.fillStyle = '#fff';
					ctx.beginPath();
					path(landFeature);
					ctx.fill();
					const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
					// -------------------------------------------

					// Draw Sphere Base (Realistic earth gradient for volumetric glow effect)
					const sphereOutline = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
					sphereOutline.setAttribute('cx', String(width / 2));
					sphereOutline.setAttribute('cy', String(height / 2 + centerYOffset));
					sphereOutline.setAttribute('r', String(globeRadius));
					sphereOutline.setAttribute('fill', 'url(#earth-gradient)'); // Natural atmospheric scattering
					sphereOutline.setAttribute('stroke', 'none');
					sphereOutline.setAttribute('style', 'filter: drop-shadow(0 0 11px rgba(246, 192, 190, 0.22))');
					svgMapContainer.insertBefore(sphereOutline, gridGroup);

					// Position city marker
					const [markerX, markerY] = projection([cityLon, cityLat]);
					if (cityDot && cityRing) {
						cityDot.setAttribute('cx', String(markerX));
						cityDot.setAttribute('cy', String(markerY));
						cityRing.setAttribute('cx', String(markerX));
						cityRing.setAttribute('cy', String(markerY));
						cityHalo?.setAttribute('cx', String(markerX));
						cityHalo?.setAttribute('cy', String(markerY));
						cityCoreGlow?.setAttribute('cx', String(markerX));
						cityCoreGlow?.setAttribute('cy', String(markerY));
						citySparkPosition?.setAttribute('transform', `translate(${markerX} ${markerY})`);
						if (cityMarkerGroup) cityMarkerGroup.style.display = 'block';
					}

					if (locationDisplay) {
						locationDisplay.textContent = cityData.label;
					}

					// Sample genuine latitude/longitude intersections, then project them onto the sphere.
					// This makes rows bend along parallels and columns converge along meridians.
					const latitudeStep = 1.15;
					const longitudeStep = 1.15;
					const viewCenter = [cityLon, cameraLat];
					let dotsHTML = '';

					for (let lat = -84.6; lat <= 84.6; lat += latitudeStep) {
						for (let lon = -180; lon < 180; lon += longitudeStep) {
							const angularDistance = d3.geoDistance(viewCenter, [lon, lat]);
							if (angularDistance >= Math.PI / 2 - 0.018) continue;

							const projectedPoint = projection([lon, lat]);
							if (!projectedPoint) continue;
							const [x, y] = projectedPoint;
							const pixelX = Math.max(0, Math.min(canvas.width - 1, Math.floor(x)));
							const pixelY = Math.max(0, Math.min(canvas.height - 1, Math.floor(y)));
							const pixelIdx = (pixelY * canvas.width + pixelX) * 4;
							const isLand = imageData[pixelIdx + 3] > 128;

							const surfaceDepth = Math.cos(angularDistance);
							let r = 0.82 + surfaceDepth * 0.72;
							if (isLand) r *= 1.18;
							const cssClass = isLand ? 'map-dot active-land' : 'map-dot';
							const dotOpacity = isLand
								? Math.min(1, 0.48 + surfaceDepth * 0.62)
								: 0.12 + surfaceDepth * 0.42;
							dotsHTML += `<circle cx="${x.toFixed(2)}" cy="${y.toFixed(2)}" r="${r.toFixed(2)}" class="${cssClass}" opacity="${dotOpacity.toFixed(2)}"></circle>`;
						}
					}
					
					// Ultra-fast bulk DOM insertion to prevent rendering bottlenecks
					gridGroup.innerHTML = dotsHTML;
				} catch (err) {
					console.error('Error rendering 3D dot-matrix globe:', err);
				}
			})();
		</script>
	</body>
</html>
