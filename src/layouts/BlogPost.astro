---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostTitle from '../components/PostTitle.astro';
import CommentSection from '../components/CommentSection.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	showComments?: boolean;
	glassTier?: 'reading' | 'page';
};

const { title, titleBreakAfter, description, pubDate, updatedDate, heroImage, showComments = true, glassTier = 'reading' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post-main { max-width: 960px; }
			.post-article { padding: clamp(1rem, 4vw, 3.2rem); }
			.hero-image { margin: 0 0 clamp(1.25rem, 4vw, 2.5rem); }
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 2.1;
				object-fit: cover;
				border-radius: clamp(12px, 2vw, 20px);
				corner-shape: superellipse(var(--liquid-glass-corner));
			}
			.prose {
				max-width: 710px;
				margin: auto;
				color: var(--text-color);
				line-height: 1.92;
			}
			.prose :global(p) { margin-bottom: 1.35rem; }
			.prose :global(a) { text-decoration: underline; text-underline-offset: 0.2em; }
			@media (max-width: 520px) {
				.prose :global(table) { display: block; max-width: 100%; overflow-x: auto; }
			}
			.prose :global(h2),
			.prose :global(h3) {
				margin-top: 2.15rem;
				margin-bottom: 0.85rem;
			}
			.title {
				max-width: 710px;
				margin: 0 auto clamp(1.15rem, 3vw, 2rem);
			}
			.article-index-link {
				display: inline-block;
				margin-bottom: 0.95rem;
				color: var(--rose-ink);
				font-size: 0.84rem;
				text-decoration: none;
			}
			.article-index-link:hover { text-decoration: underline; }
			.post-description {
				margin: 0.65rem 0 0;
				font-size: clamp(1rem, 2vw, 1.16rem);
				color: var(--text-muted);
				line-height: 1.6;
			}
			.date {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1rem;
				margin-bottom: 0.68rem;
				color: var(--cool-ink);
				font-size: 0.88rem;
			}
			.last-updated-on { color: var(--text-muted); }
		</style>
	</head>
 
	<body>
		<Header />
		<main class="post-main">
			<article class="post-article glass-card" data-glass-tier={glassTier}>
				<div class="title">
					{Astro.url.pathname.startsWith('/blog/') && <a class="article-index-link" href="/blog">← 文章</a>}
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && <span class="last-updated-on">更新于 <FormattedDate date={updatedDate} /></span>}
					</div>
					<h1 class="editorial-title"><PostTitle title={title} breakAfter={titleBreakAfter} /></h1>
					{description && <p class="post-description">{description}</p>}
				</div>
				{heroImage && <div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt={`${title} 封面图`} loading="eager" />
				</div>}
				<div class="prose">
					<slot />
				</div>
			</article>
			{showComments && <CommentSection />}
		</main>
		<Footer />
	</body>
</html>
