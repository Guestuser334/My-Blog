---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	heroImage?: ImageMetadata;
}

const { title, description, heroImage } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} | Skittles’s Blog`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article class="page-card glass-card">
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={`${title} 页面封面`} />
					</div>
				)}
				<header class="page-heading">
					<p class="eyebrow">SKITTLES’S BLOG</p>
					<h1>{title}</h1>
					<p>{description}</p>
				</header>
				<div class="page-content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 900px; }
	.page-card {
		padding: 2.4rem;
		background: var(--material-thick);
		border-color: var(--material-border);
		-webkit-backdrop-filter: blur(14px) saturate(135%);
		backdrop-filter: blur(14px) saturate(135%);
	}
	.hero-image { margin-bottom: 2rem; }
	.hero-image :global(img) {
		display: block;
		width: 100%;
		max-height: 420px;
		object-fit: cover;
		border-radius: 18px;
	}
	.page-heading {
		max-width: 720px;
		margin: 0 auto 2.4rem;
		text-align: center;
	}
	.eyebrow {
		margin: 0 0 0.45rem;
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.14em;
	}
	h1 { margin-bottom: 0.65rem; font-size: 2.35rem; }
	.page-heading > p:last-child { margin: 0; color: rgba(255, 255, 255, 0.76); }
	.page-content { max-width: 720px; margin: 0 auto; }

	@media (max-width: 720px) {
		main { max-width: calc(100% - 1rem); }
		.page-card { padding: 1.1rem; }
		.hero-image { margin-bottom: 1.4rem; }
		.hero-image :global(img) { border-radius: 13px; }
		.page-heading { margin-bottom: 1.7rem; }
		h1 { font-size: 1.9rem; }
	}
</style>
