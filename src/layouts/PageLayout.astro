---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	heroImage?: ImageMetadata;
}

const { title, description, heroImage } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} | Skittles’s Blog`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article class="page-card glass-card" data-glass-tier="page">
				<div class="page-heading">
					<p class="eyebrow">SKITTLES’S BLOG</p>
					<h1 class="editorial-title">{title}</h1>
					<p>{description}</p>
				</div>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={`${title} 页面封面`} />
					</div>
				)}
				<div class="page-content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 960px; }
	.page-card {
		--page-card-padding: clamp(1.2rem, 5vw, 3.3rem);
		padding: var(--page-card-padding);
	}
	.hero-image { margin-bottom: 2rem; }
	.hero-image :global(img) {
		display: block;
		width: 100%;
		max-height: 420px;
		object-fit: cover;
		border-radius: max(var(--liquid-glass-control-radius), calc(var(--liquid-glass-card-radius) - var(--page-card-padding)));
		corner-shape: superellipse(var(--liquid-glass-corner));
	}
	.page-heading {
		max-width: 720px;
		margin: 0 auto 1.6rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--panel-line);
	}
	.eyebrow {
		margin: 0 0 0.45rem;
		color: var(--rose-ink);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.14em;
	}
	h1 { margin-bottom: 0.65rem; }
	.page-heading > p:last-child { margin: 0; color: var(--text-muted); }
	.page-content { max-width: 720px; margin: 0 auto; }

	@media (max-width: 720px) {
		.hero-image { margin-bottom: 1.4rem; }
		.page-heading { margin-bottom: 1.7rem; }
	}
</style>
